# Polski Konwerter — Konfiguracja Środowiskowa (.env)

# Port i host serwera
HOST=127.0.0.1
PORT=8000

# Limity przesyłania plików
PK_MAX_FILE_SIZE=52428800           # 50 MB w bajtach
PK_MAX_QUEUE_FILES=10              # Maksymalna liczba plików w kolejce naraz
PK_RETENTION_SECONDS=1800          # Czas przechowywania plików tymczasowych (30 min)
PK_MAX_CONCURRENT_TASKS=4          # Maksymalna liczba równoległych konwersji
PK_RATE_LIMIT=60                   # Limit żądań API na minutę
